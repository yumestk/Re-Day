{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the bundled main window can manage the local daily plan.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-load-day",
    "allow-create-quest",
    "allow-edit-quest",
    "allow-set-completion",
    "allow-save-preferences",
    "allow-load-workspace",
    "allow-save-goal",
    "allow-save-quest",
    "allow-set-quest-state",
    "allow-record-execution",
    "allow-load-quest-history",
    "allow-schedule-quest",
    "allow-preview-quest-delete",
    "allow-delete-quest",
    "allow-preview-recurrence",
    "allow-save-recurrence",
    "allow-load-instances",
    "allow-reschedule-instance",
    "allow-load-calendar",
    "allow-load-date",
    "allow-load-review-prompt",
    "allow-save-review",
    "allow-skip-plan",
    "allow-preview-ordinary-reschedule",
    "allow-reschedule-ordinary",
    "allow-list-life-events",
    "allow-load-life-event",
    "allow-save-life-event",
    "allow-delete-life-event",
    "allow-pick-life-event-images",
    "allow-discard-life-event-images",
    "allow-load-storage-info",
    "allow-export-backup",
    "allow-inspect-backup",
    "allow-discard-backup",
    "allow-restore-backup",
    "allow-retry-storage-cleanup"
  ]
}
